# Supabase Auth — Vercel injects NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# For local dev, copy from Supabase Dashboard > Project Settings > API (API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend override for local Next rewrites (optional)
# BACKEND_URL=http://localhost:8000

# Dev mock — leave false (or unset) to use real Supabase auth
# NEXT_PUBLIC_MOCK_USER=false
