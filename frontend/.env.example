# Supabase Auth — Vercel injects NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Local dev: scripts/local-supabase.sh up writes these for the local stack
# (see docs/local-dev.md).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend URL for Next rewrites and direct character chat streaming (optional)
# BACKEND_URL=http://localhost:8000

# There is no mock user. Against the local stack, the login page offers
# one-click seeded test players and each tab keeps its own session.
