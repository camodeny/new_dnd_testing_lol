# Supabase Auth — Vercel injects NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# For local dev, copy from Supabase Dashboard > Project Settings > API (API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend override for local Next rewrites (optional)
# BACKEND_URL=http://localhost:8000
# Same URL, client-side: character components call the backend directly
# because SSE bypasses Next rewrites. Must match BACKEND_URL.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Local development auth — there is no mock user. Sign in through the app
# with a dev user created in the Supabase Dashboard > Authentication > Users
# (see docs/local-dev-auth.md). A real session is required: realtime private
# channels cannot connect without one.
#
# Optional dev auto-login: fills the Supabase session automatically in local
# `next dev` so dogfooding skips the login form. Ignored in production
# builds even if present. NEVER set these in a deployed environment.
# NEXT_PUBLIC_DEV_USER_EMAIL=dev@example.com
# NEXT_PUBLIC_DEV_USER_PASSWORD=...
