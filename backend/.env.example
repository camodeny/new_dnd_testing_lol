# Supabase Postgres — Vercel injects POSTGRES_URL (pooled 6543), POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING
# For local dev, paste from Supabase Dashboard > Database > Connection string
POSTGRES_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Also accepted: POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, DATABASE_URL

# Supabase Auth — Vercel injects: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
#                               NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Optional override if your JWKS lives elsewhere
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Local development and automated tests only: explicitly allow unauthenticated
# requests to use a mock profile. Requires BOTH the backend flag and a
# non-production environment marker (fail-closed if metadata is missing):
#   ALLOW_MOCK_AUTH=true + NODE_ENV=development (local) or NODE_ENV=test (CI)
#   or VERCEL_ENV=development/preview (Vercel non-prod).
# The backend ignores NEXT_PUBLIC_MOCK_USER; known production environments
# (VERCEL_ENV=production or NODE_ENV=production, case/whitespace-insensitive)
# refuse mock auth even if the flag is present. Missing/unknown metadata also
# fails closed. Invalid bearer tokens are still rejected (401) when mock auth
# is enabled.
# ALLOW_MOCK_AUTH=true
# NODE_ENV=development

# LLM providers: provider + model are pinned in code per call area
# (see backend/app/providers/areas.py). Only API keys come from env.
# LLM_PROVIDER / *_PROVIDER / *_MODEL vars are not consulted.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# MODEL_API_KEY=  # Meta Model API (aliases: META_API_KEY, LLAMA_API_KEY)
