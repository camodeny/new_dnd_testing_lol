# Supabase Postgres — Vercel injects POSTGRES_URL (pooled 6543), POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING
# For local dev, paste from Supabase Dashboard > Database > Connection string
POSTGRES_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Also accepted: POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, DATABASE_URL

# Supabase Auth — Vercel injects: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
#                               NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Optional override if your JWKS lives elsewhere
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Local development auth — there is no mock/dev bypass. Every request must
# bear a real Supabase JWT: sign in through the app with a dev user created
# in the Supabase Dashboard > Authentication > Users (see
# docs/local-dev-auth.md). The backend verifies the token via JWKS and
# upserts the profile automatically. Unauthenticated requests get 401.
# No auth env vars are needed beyond the Supabase keys above.

# Lobby invite email delivery — issue #242. Single canonical integration,
# selected via INVITE_EMAIL_PROVIDER (log | smtp | resend | sendgrid).
# Default "log" sends nothing: the invite link/code fallback always works
# and sending can be retried after a provider is configured.
# INVITE_EMAIL_PROVIDER=log
# Origin used to build shareable invite URLs ({origin}/invite/{CODE}).
# INVITE_BASE_URL=http://localhost:3000
# PUBLIC_APP_URL=  # fallback when INVITE_BASE_URL is unset
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# INVITE_EMAIL_FROM=

# LLM providers: provider + model are pinned in code per call area
# (see backend/app/providers/areas.py). Only API keys come from env.
# LLM_PROVIDER / *_PROVIDER / *_MODEL vars are not consulted.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# META_API_KEY=  # Meta Model API
