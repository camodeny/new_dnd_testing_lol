# Supabase Postgres — Vercel injects POSTGRES_URL (pooled 6543), POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING
# For local dev, paste from Supabase Dashboard > Database > Connection string
POSTGRES_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Also accepted: POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, DATABASE_URL

# Supabase Auth — Vercel injects: SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY,
#                               NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Optional override if your JWKS lives elsewhere
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Local dev only: allow unauthenticated requests to use a mock profile (never set in Vercel production).
# Invalid bearer tokens are still rejected (401) even when this is enabled.
# ALLOW_MOCK_AUTH=true
